# Photon Fusion SDK is licensed per-developer and downloaded from the Photon
# Dashboard - it is deliberately NOT committed. See docs/PHOTON_SETUP.md.
Plugins/PhotonFusion/

# Unreal asset trash
Content/Collections/
Content/Developers/
Content/**/*.uasset.tmp

# OS
Thumbs.db
desktop.ini
.DS_Store

# Epic Games template content (Mannequins, template weapons, prototype grid).
# Licensed under the Unreal Engine EULA, which does not allow redistributing
# it in source form publicly. It is copied from YOUR engine install by
# Scripts/copy_epic_content.py - see docs/ASSETS.md. Cooked into builds, as
# the EULA permits.
Content/Characters/Mannequins/
Content/Weapons/Pistol/
Content/Weapons/Rifle/
Content/Weapons/GrenadeLauncher/
Content/LevelPrototyping/

# v1.1: raw downloads (only prepared clips are committed)
SourceArt/_download/

# Accounts: local keys, never committed (template: Config/Backend.ini.example)
Config/Backend.ini

# v2.0: NVIDIA DLSS / Streamline plugins - NVIDIA's license does not allow
# redistributing them in a public repository. Each developer downloads them
# from developer.nvidia.com (see docs/ASSETS.md).
Plugins/DLSS*/
Plugins/Streamline*/
Plugins/NIS/

# Python bytecode from the content scripts
__pycache__/
